{
  "name": "cybersecurity-learning-map",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:browser": "node tests/browser.mjs && node tests/deep-browser.mjs && node tests/workbench-browser.mjs",
    "test:models": "node --experimental-strip-types tests/deep-model.mjs && node --experimental-strip-types tests/workbench-model.mjs",
    "test:v2": "node --experimental-strip-types tests/v2-model.mjs",
    "test": "pnpm test:models && pnpm test:v2",
    "test:v2:browser": "node --experimental-strip-types tests/v2-browser.mjs"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "vue": "3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.5",
    "playwright": "^1.63.0",
    "typescript": "~5.9.3",
    "vite": "8.2.2",
    "vue-tsc": "^3.2.6"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
